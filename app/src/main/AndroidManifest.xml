<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 共有先 (Muse) を探すための可視性宣言 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="image/*" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <!-- 起動役 兼 レイヤー: root screencap で撮影し、その場で囲む -->
        <activity
            android:name=".CaptureActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@style/CaptureTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 切り抜き画像の受け渡し (内部キャッシュの固定1ファイル) -->
        <provider
            android:name=".CropShareProvider"
            android:authorities="com.overnight.kakottemuse.share"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!-- クイック設定タイルからも起動できるようにする -->
        <service
            android:name=".MuseTileService"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

    </application>

</manifest>
